[Unit]
Description=OMCP ONION Node Agent Daemon
After=network.target

[Service]
Type=simple
User=onion
Group=onion
WorkingDirectory=/opt/omcp-onion
EnvironmentFile=/etc/omcp-onion/agent.env
ExecStart=/opt/omcp-onion/venv/bin/python3 -m agent.onion_agent
Restart=always
RestartSec=5
LimitNOFILE=65535
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
